APP_NAME=Wedding Memories
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:5173

# Configure these only in your ignored local backend/.env file.
MONGODB_URI=
MONGODB_DATABASE=wedding_memories

# Generate a random 48-byte URL-safe value; never commit the resulting secret.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

PHOTO_STORAGE_PROVIDER=local
PHOTO_STORAGE_LOCAL_PATH=storage-data
# Google Drive OAuth is optional while local storage is selected.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8011/api/v1/integrations/google-drive/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
# During key rotation, temporarily set the old key here; remove after all credentials have been re-encrypted.
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY_PREVIOUS=
# Optional existing folder accessible to this OAuth app; otherwise the app creates its own folder.
GOOGLE_DRIVE_FOLDER_ID=
UPLOAD_SESSION_MINUTES=30
UPLOAD_MAX_FILE_BYTES=12582912
UPLOAD_MAX_REQUEST_BYTES=57671680
UPLOAD_MAX_FILES_PER_REQUEST=10
UPLOAD_MAX_FILES_PER_SESSION=30
UPLOAD_MAX_BYTES_PER_SESSION=104857600
UPLOAD_SESSIONS_PER_IP_PER_HOUR=20
UPLOAD_REQUESTS_PER_IP_PER_HOUR=30
